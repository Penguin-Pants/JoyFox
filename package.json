{
  "name": "joyfox",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "build:firefox": "node scripts/build-firefox.mjs",
    "build:chrome": "node scripts/build-chrome.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-permissions.mjs && node scripts/check-release.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:amo": "web-ext lint --source-dir dist/firefox --self-hosted",
    "package:source": "node scripts/package-source.mjs",
    "package:chrome": "npm run build:chrome && web-ext build --source-dir dist/chrome --artifacts-dir dist --filename joyfox-{version}-chrome.zip --overwrite-dest"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/firefox-webext-browser": "120.0.4",
    "@types/node": "24.5.2",
    "esbuild": "0.25.10",
    "eslint": "9.36.0",
    "fake-indexeddb": "6.2.2",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "^4.1.11",
    "web-ext": "10.7.0"
  }
}
