{
  "manifest_version": 3,
  "name": "JoyFox",
  "version": "1.0.0",
  "description": "Local-first enhancements for pages you open on JoyClub.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "148",
  "permissions": ["storage"],
  "host_permissions": ["*://*.joyclub.de/*", "*://*.joyce.app/*"],
  "action": {
    "default_title": "JoyFox",
    "default_icon": {
      "16": "icons/action-16.png",
      "24": "icons/action-24.png",
      "32": "icons/action-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.joyclub.de/*", "*://*.joyce.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "css": ["content.css"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
